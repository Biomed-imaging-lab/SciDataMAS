{
  "name": "scidatamas-dsh-plugin",
  "version": "0.1.0",
  "description": "SciDataMAS for DeepSeek Harness: a tool-driven scientific data lake with adaptable metadata, debate-based schema validation, and local-first storage.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./service": "./src/service.js",
    "./package.json": "./package.json",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE",
    "docs",
    "scripts"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "scientific-data",
    "metadata",
    "data-lake",
    "zenodo"
  ]
}
