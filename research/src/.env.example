# Copy to `.env` and fill in the keys you actually use.
# The Streamlit app loads this file via python-dotenv.

# --- Model providers ---
OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- Optional: LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scidatamas

# --- Optional: ClearML storage backend ---
CLEARML_WEB_HOST=
CLEARML_API_HOST=
CLEARML_FILES_HOST=
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
CLEARML_S3_ACCESS_KEY=
CLEARML_S3_SECRET_KEY=
CLEARML_S3_HOST=
CLEARML_S3_REGION=

# --- Optional: S3-compatible storage ---
S3_ENDPOINT=
