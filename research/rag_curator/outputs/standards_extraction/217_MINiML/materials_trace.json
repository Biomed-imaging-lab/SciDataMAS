  "roster": [
    {
      "standard_id": "MINiML",
      "name": "MINiML (MIAME Notation in Markup Language)",
      "description": "An XML Schema data-exchange format for microarray and other high-throughput molecular-abundance data. Defines core objects Platform, Sample, and Series and element-level constraints (titles, organism, protocols, data tables). Captures the full MIAME checklist and is presented as the XML rendering of GEO's SOFT format."
    },
    {
      "standard_id": "SOFT",
      "name": "SOFT (Simple Omnibus Format in Text)",
      "description": "A plain-text/tab-delimited data-exchange format used by GEO for representing platforms, samples, and series. Emphasizes simple, easy-to-parse text encoding for data tables and metadata; MINiML is documented as an XML rendering of SOFT."
    },
    {
      "standard_id": "MIAME",
      "name": "MIAME (Minimum Information About a Microarray Experiment)",
      "description": "A minimum-information checklist specifying the metadata required to interpret and reproduce microarray experiments (sample characteristics, protocols, data processing, platforms). The MINiML documentation states it captures all components of the MIAME checklist."
    },
    {
      "standard_id": "NCBI Taxonomy",
      "name": "NCBI Taxonomy nomenclature",
      "description": "A controlled nomenclature/taxonomic standard for organism names used in metadata fields (e.g., Organism entries) — the MINiML element guidelines require use of the NCBI Taxonomy nomenclature for organism identification."
    }
  ],
