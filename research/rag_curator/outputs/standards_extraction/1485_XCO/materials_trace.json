    {
      "standard_id": "CMO",
      "name": "Clinical Measurement Ontology",
      "description": "Ontology of clinical and physiological phenotype measurements (what is measured): standardized terms to describe measured traits/variables across human and model-organism studies to support integration and querying of phenotype measurement data."
    },
    {
      "standard_id": "MMO",
      "name": "Measurement Method Ontology",
      "description": "Ontology of measurement methods and protocols (how measurements are made): controlled vocabulary describing techniques, assays, and procedures used to obtain phenotype measurements across studies."
    },
    {
      "standard_id": "XCO",
      "name": "Experimental Condition Ontology",
      "description": "Ontology of experimental conditions and treatments (context/conditions affecting measurements): terms for environmental factors, treatments, and sample/subject states (e.g., housing, diet, stress, surgical manipulations) used to annotate the conditions under which phenotype measurements were taken."
    }
  ],
