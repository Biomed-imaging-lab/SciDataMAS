  "roster": [
    {
      "standard_id": "AMIS",
      "name": "Article Minimum Information Standard (AMIS)",
      "description": "A minimal-information reporting guideline for ascidian experimental articles covering required fields for: wild-type spatio-temporal expression (developmental stage, clone/probe/antibody, anatomical annotation), molecular perturbations (identity of deregulated molecule, interference type, molecular tool details, onset stage), anatomical perturbations (time, removed anatomy/explant described using Aniseed anatomy), molecular phenotypes, and morphological phenotypes. Implemented via detailed submission templates/Excel forms and an ‘article card’ concept to ensure curation completeness."
    },
    {
      "standard_id": "ANISEED_Anatomical_Ontology",
      "name": "ANISEED Anatomical Ontology (Anatomical dictionary)",
      "description": "A controlled anatomical ontology/dictionary for ascidian embryos used to annotate anatomical territories and parts across datasets. Used in curation and submission instructions to describe expression territories, removed anatomy, and to standardize annotations in figure legends and database entries."
    },
    {
      "standard_id": "Hotta_2007_Developmental_Staging",
      "name": "Hotta et al. 2007 standard ascidian developmental staging table",
      "description": "A standardized developmental-stage table for ascidians (Hotta et al. 2007) used as the reference staging system for annotating when expression and perturbation experiments were performed; ANISEED specifies use of this staging table (with a compression of tailbud stages) for all submissions."
    }
  ],
