  "roster": [
    {
      "standard_id": "MIxS",
      "name": "MIxS (Minimum Information about any (x) Sequence)",
      "description": "Umbrella metadata framework from the Genomic Standards Consortium defining core descriptors and environmental ‘packages’ for reporting contextual metadata about genomic, metagenomic and marker-gene sequences; provides checklists and conventions used by other MIxS-specific checklists."
    },
    {
      "standard_id": "MIMS",
      "name": "MIMS (Metagenome or Environmental)",
      "description": "A MIxS checklist focused on metagenome/environmental samples (also presented as ‘MIMS’ or ‘mims’); specifies fields such as sample name, collection_date, geo_loc_name, env_broad_scale, seq_meth and many other sample- and sequencing-related metadata elements."
    },
    {
      "standard_id": "MIGS",
      "name": "MIGS (Minimum Information about a Genome Sequence)",
      "description": "MIxS-based checklist for reporting contextual metadata about isolate genome sequences (MIGS), with variants/packages for different organism types (bacteria/archaea, eukaryotes, viruses) and habitat-specific packages."
    },
    {
      "standard_id": "MIMARKS",
      "name": "MIMARKS (Minimum Information about a Marker Sequence)",
      "description": "MIxS-based checklist for marker gene sequence data (e.g., amplicon/marker studies); specifies specimen/sample attributes and environmental packages to standardize reporting for marker-gene datasets."
    },
    {
      "standard_id": "MIMAG",
      "name": "MIMAG (Minimum Information about a Metagenome-Assembled Genome)",
      "description": "Checklist for metagenome-assembled genomes (MAGs) covering assembly- and genome-quality metadata, contextual sample information and package variants for different environments."
    }
  ],
