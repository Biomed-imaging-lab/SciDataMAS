{
  "record_id": "1351",
  "record_dir": "1351_MIBiG",
  "standards": [
    {
      "standard_id": "MIBiG",
      "name": "Minimum Information about a Biosynthetic Gene cluster (MIBiG)",
      "abstract": "MIBiG describes experimentally characterized biosynthetic gene clusters (BGCs) and their molecular products. The research objects are BGCs from bacteria, fungi and plants, annotated with genomic locus information (GenBank/ENA/DDBJ accessions and coordinates), gene annotations (functions and domains), biosynthetic modules/paths, and the chemical compounds produced (structures, masses, activities). The standard is published and maintained by the MIBiG community project (a Genomic Standards Consortium checklist/extension) and distributed as a set of JSON schemas, submission forms and a public repository. It addresses the problem of dispersed and heterogeneous reporting of BGC experimental and contextual data by specifying concrete machine-readable metadata fields, allowed types/enums and evidence descriptors, enabling validation, database deposition, systematic queries and programmatic downloads of JSON/GBK/FASTA dumps.",
      "classification": {
        "assigned_types": [
          "table"
        ],
        "fairsharing_record_type_hint": null,
        "rationale": "The source material provides an explicit machine-readable JSON schema and form definitions that name fields and enforce concrete types (strings, numbers, enums, arrays, objects) and allowed values. This is a true metadata table/schema rather than prose guidance or an ordered workflow; fields such as 'accession', 'loci', 'compounds', 'biosynthesis' and enumerated vocabularies (status/quality/completeness) are defined in the schema."
      },
      "principles": null,
      "dag": null,
      "table": {
        "fields": {
          "accession": {
            "name": "accession",
            "descr": "MIBiG entry identifier (BGCxxxxxxx)",
            "type": "string",
            "possible_values": null,
            "evidence": "\"entryId\": { \"type\": \"string\", \"format\": \"BGC\\\\d{7,7}\" }",
            "raw_full_info": {}
          },
          "version": {
            "name": "version",
            "descr": "Schema/data version number for the entry",
            "type": "number",
            "possible_values": null,
            "evidence": "\"version\": { \"type\": \"number\", \"minValue\": 1 }",
            "raw_full_info": {}
          },
          "changelog": {
            "name": "changelog",
            "descr": "Changelog / release history for the entry (structured object)",
            "type": "object",
            "possible_values": null,
            "evidence": "\"changelog\": { \"$ref\": \"/schemas/common/changelog.json\" }",
            "raw_full_info": {}
          },
          "quality": {
            "name": "quality",
            "descr": "Curatorial quality score of the entry",
            "type": "enum/controlled_vocabulary",
            "possible_values": [
              "questionable",
              "low",
              "medium",
              "high"
            ],
            "evidence": "\"quality\": { \"$ref\": \"#/$defs/quality\" }\" and \"\\\"quality\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"questionable\\\", \\\"low\\\", \\\"medium\\\", \\\"high\\\"] }\"",
            "raw_full_info": {}
          },
          "status": {
            "name": "status",
            "descr": "Curation/publication status of the entry",
            "type": "enum/controlled_vocabulary",
            "possible_values": [
              "pending",
              "embargoed",
              "active",
              "retired"
            ],
            "evidence": "\"status\": { \"$ref\": \"#/$defs/status\" }\" and \"\\\"status\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"pending\\\", \\\"embargoed\\\", \\\"active\\\", \\\"retired\\\"] }\"",
            "raw_full_info": {}
          },
          "completeness": {
            "name": "completeness",
            "descr": "Completeness of the reported gene cluster sequence",
            "type": "enum/controlled_vocabulary",
            "possible_values": [
              "unknown",
              "incomplete",
              "complete"
            ],
            "evidence": "\"completeness\": { \"$ref\": \"#/$defs/completeness\" }\" and \"\\\"completeness\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"unknown\\\", \\\"incomplete\\\", \\\"complete\\\"] }\"",
            "raw_full_info": {}
          },
          "loci": {
            "name": "loci",
            "descr": "Array of genomic locus objects describing accession, coordinates and evidence that the locus encodes the BGC",
            "type": "array of object (accession:string, location:object(from:integer,to:integer), evidence:array)",
            "possible_values": null,
            "evidence": "\"loci\": { \"type\": \"array\", \"items\": { \"$ref\": \"/schemas/mibig/locus.json\" }, \"minItems\": 1, \"uniqueItems\": true }\" and from locus.json: \"\\\"required\\\": [\\\"accession\\\", \\\"location\\\", \\\"evidence\\\"]\"",
            "raw_full_info": {}
          },
          "biosynthesis": {
            "name": "biosynthesis",
            "descr": "Structured biosynthesis description (classes, modules, paths, operons) describing enzymatic classes, modules and pathway steps",
            "type": "object",
            "possible_values": null,
            "evidence": "\"biosynthesis\": { \"$ref\": \"/schemas/mibig/biosynthesis/biosynthesis.json\" }\" and biosynthesis schema: \"\\\"required\\\": [\\\"classes\\\", \\\"paths\\\"]\"",
            "raw_full_info": {}
          },
          "compounds": {
            "name": "compounds",
            "descr": "Array of compound descriptions produced by the cluster (names, structures, activities, database identifiers, evidence)",
            "type": "array of object",
            "possible_values": null,
            "evidence": "\"compounds\": { \"type\": \"array\", \"items\": { \"$ref\": \"/schemas/mibig/compound.json\" }, \"minItems\": 1, \"uniqueItems\": true }\"",
            "raw_full_info": {}
          },
          "genes": {
            "name": "genes",
            "descr": "Gene annotations and domains for genes in the cluster (annotations array, domains array)",
            "type": "object",
            "possible_values": null,
            "evidence": "\"genes\": { \"$ref\": \"/schemas/mibig/genes.json\" }\" and genes.json defines \"annotations\" and \"domains\" structures",
            "raw_full_info": {}
          },
          "taxonomy": {
            "name": "taxonomy",
            "descr": "Organism taxonomy for the source organism",
            "type": "object (name:string, ncbiTaxId:integer)",
            "possible_values": null,
            "evidence": "\"taxonomy\": { \"$ref\": \"/schemas/mibig/taxonomy.json\" }\" and taxonomy.json: \"\\\"required\\\": [\\\"name\\\", \\\"ncbiTaxId\\\"]\"",
            "raw_full_info": {}
          },
          "comment": {
            "name": "comment",
            "descr": "Free-text comment field for the entry",
            "type": "string",
            "possible_values": null,
            "evidence": "\"comment\": { \"type\": \"string\" }",
            "raw_full_info": {}
          }
        }
      },
