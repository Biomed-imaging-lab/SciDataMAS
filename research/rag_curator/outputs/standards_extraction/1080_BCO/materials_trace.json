  "roster": [
    {
      "standard_id": "BCO",
      "name": "Biological Collections Ontology (BCO)",
      "description": "An OWL ontology for biodiversity collection data: models material samples (specimens), sampling and observing processes, specimen relationships (individuals, lots, vouchers), and properties such as collector, location, time, storage, containers, institution, and collection identifiers. Part of the OBO Foundry; primary subject of the repository, README, OWL files, and manuscript."
    },
    {
      "standard_id": "DwC",
      "name": "Darwin Core (DwC) / DwC Types",
      "description": "A biodiversity metadata vocabulary for occurrence and specimen records (terms like occurrenceID, materialSampleID, locality, decimalLatitude/Longitude, coordinateUncertaintyInMeters, etc.) and the DwC type vocabulary. The seed contains dwcterms/dwctype OWL/RDF imports, mappings, and example RDF using DwC terms."
    },
    {
      "standard_id": "ISO19156",
      "name": "Observations and Measurements (OGC/ISO 19156)",
      "description": "OGC/ISO standard (Observations and Measurements) describing a model for observations, measurements, observation context, results and sampling features. The seed includes the full OGC/ISO 19156 (Topic 20) PDF, indicating substantive use of the model."
    },
    {
      "standard_id": "EnvO",
      "name": "Environment Ontology (EnvO)",
      "description": "An OBO ontology of environmental descriptors (habitats, environmental features) used to describe sample environments. The manuscript linked in the seed explicitly discusses EnvO alongside BCO as a standard to describe biodiversity samples and environments."
    },
    {
      "standard_id": "PCO",
      "name": "Population and Community Ontology (PCO)",
      "description": "An OBO ontology for representing populations and communities (population-level entities and related processes). The manuscript and import files indicate PCO is part of the set of ontologies BCO aligns with and imports."
    },
    {
      "standard_id": "BFO",
      "name": "Basic Formal Ontology (BFO)",
      "description": "An upper-level ontology providing foundational classes (independent continuant, material entity, immaterial entity/site, process) used as BCO's upper ontology. The seed contains BFO Ontofox notes and hand edits (bfo_site_by_hand.txt), showing substantive handling of BFO terms."
    },
    {
      "standard_id": "OBI",
      "name": "Ontology for Biomedical Investigations (OBI)",
      "description": "An ontology of planned processes, assays, specimens, protocols, organizations and data items used by BCO to model sampling and laboratory processes. The seed includes OBI Ontofox import configuration and many imports/usage of OBI classes (specimen, planned process, assay)."
    },
    {
      "standard_id": "IAO",
      "name": "Information Artifact Ontology (IAO)",
      "description": "An ontology for information content entities, documents and data items. The seed contains IAO Ontofox import files and uses IAO concepts (information content entity, data item) in the BCO OWL artifacts."
    },
    {
      "standard_id": "RO",
      "name": "OBO Relations Ontology (RO)",
      "description": "A relations ontology providing predicates like has_input, has_output, has_part, part_of used throughout BCO. The seed includes RO Ontofox files and import references indicating substantive use."
    }
  ],
