  "roster": [
    {
      "standard_id": "MIxS",
      "name": "MIxS (Minimum Information about any (X) Sequence)",
      "description": "A family-level metadata standard/specification maintained by the Genomic Standards Consortium that defines terms, checklists, environmental extensions and combinations for describing sequence data and their contextual/sample metadata (checklists, extensions, modular combinations). Provided as a LinkML YAML schema with generated artifacts (JSON-LD, OWL, JSON Schema, spreadsheets)."
    },
    {
      "standard_id": "MIGS",
      "name": "MIGS (Minimal Information about a Genome Sequence)",
      "description": "A MIxS checklist targeting metadata required/recommended/optional for genome-sequence datasets; supports taxon-specific variants (e.g., bacteria, eukaryote, virus, organelle, plant) as described in the MIxS materials."
    },
    {
      "standard_id": "MIMS",
      "name": "MIMS (Minimal Information about a Metagenome Sequence)",
      "description": "A MIxS checklist for describing metagenome/metagenomic sequencing datasets and their contextual/sample metadata (used for microbiome/metagenome studies)."
    },
    {
      "standard_id": "MIMARKS",
      "name": "MIMARKS (Minimal Information about a Marker Sequence)",
      "description": "A MIxS checklist for marker-gene sequence data (marker sequences), with variants such as specimen vs survey; defines the slots/terms needed to report marker gene sequencing metadata."
    },
    {
      "standard_id": "MIMAG",
      "name": "MIMAG (Minimal Information about a Metagenome-Assembled Genome)",
      "description": "A MIxS checklist specifying metadata fields relevant to metagenome-assembled genomes (MAGs)."
    },
    {
      "standard_id": "MISAG",
      "name": "MISAG (Minimal Information about a Single Amplified Genome / Single-cell genome)",
      "description": "A MIxS checklist for single-cell / single-amplified genome assemblies (metadata describing sampling and processing of single-cell genomes)."
    },
    {
      "standard_id": "MIUVIG",
      "name": "MIUVIG (Minimal Information about an Uncultivated Viral Genome)",
      "description": "A MIxS checklist for metadata describing uncultivated viral genomes (UViGs)."
    },
    {
      "standard_id": "MIxS-Ag",
      "name": "MIxS Agriculture Extension (MIxS-Ag)",
      "description": "A MIxS environmental extension providing agriculture-specific metadata terms to describe agricultural sampling contexts (terms and guidance for agricultural environments)."
    },
    {
      "standard_id": "MIxS-Ancient",
      "name": "MIxS Ancient (palaeogenomics) Extension",
      "description": "An extension (documented in the project diffs) adding ancient/archaeological/palaeogenomic metadata terms (chronology, preservation, stratigraphy and related provenance fields) to MIxS checklists."
    },
    {
      "standard_id": "MIxS-Food",
      "name": "MIxS Food Package / Extension",
      "description": "A MIxS measurement package/extension covering food-related provenance, processing, packaging and traceability metadata (food-specific fields such as traceability, processing, packaging, labels, additives)."
    },
    {
      "standard_id": "LinkML",
      "name": "LinkML (modeling framework)",
      "description": "A metadata modeling/schema framework used to author MIxS (the MIxS schema is expressed as LinkML YAML and generated artifacts). Included here because the seed material documents use of LinkML to define and maintain the MIxS schema (but LinkML is a modeling framework rather than the MIxS content standard)."
    }
  ],
