  "roster": [
    {
      "standard_id": "MI-CLAIM",
      "name": "MI-CLAIM (Minimum Information for Clinical AI Modeling)",
      "description": "A reporting/checklist standard for clinical artificial intelligence (supervised ML) studies. Specifies items to include for transparent reporting and reproducibility: clinical problem and research question, cohort characteristics and representativeness, data origin and preprocessing, training/test separation, model/selection details, primary algorithm and clinical utility metrics and justification, model examination/interpretability techniques, robustness/distribution-shift discussion, and reproducibility tiers (code sharing, third‑party evaluation, VM/binary, or no sharing). Provided as a checklist/table to accompany manuscripts and models, with an associated community GitHub repo and example files."
    }
  ],
