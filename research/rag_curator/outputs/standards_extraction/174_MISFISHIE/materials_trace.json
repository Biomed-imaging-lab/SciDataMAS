  "roster": [
    {
      "standard_id": "MISFISHIE",
      "name": "MISFISHIE (Minimum Information Specification For In Situ Hybridization and Immunohistochemistry Experiments)",
      "description": "Minimum-information reporting guideline for visual tissue gene-expression localization experiments (in situ hybridization, immunohistochemistry, reporter/GFP/beta-gal experiments). Specifies what metadata to provide (experimental design, biomaterials and treatments, reporter/probe/antibody identification and attributes, staining protocols and parameters, imaging data and image characterizations, contacts and related resources). A MIAME-style checklist (not a file format) developed within the MGED community; intended to enable reproducibility and evaluation of image-based expression data."
    }
  ],
