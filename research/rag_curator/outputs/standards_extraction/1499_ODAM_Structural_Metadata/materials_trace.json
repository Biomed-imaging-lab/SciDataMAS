    {
      "standard_id": "frictionless-data",
      "name": "Frictionless Data (Data Package / Table Schema / CSV Dialect)",
      "description": "A specification family for packaging and describing tabular data collections and their structure: the Data Package container (datapackage.json), Table Schema for column/field definitions, and CSV Dialect for CSV formatting. The ODAM seed explicitly states its datapackage is very close to Frictionless Data v1 and links to the Frictionless specs."
    },
    {
      "standard_id": "json-schema",
      "name": "JSON Schema",
      "description": "The JSON Schema specification used to describe the structure of JSON documents. The ODAM pages state the ODAM datapackage is based on JSON Schema and provide JSON Schema files (odam-data-package.json, odam-data-resource.json) describing their package/resource structures."
    },
    {
      "standard_id": "odam-datapackage",
      "name": "ODAM Data Package (ODAM JSON Schema profile)",
      "description": "An ODAM-specific metadata/profile for packaging experimental data tables: a JSON-Schema-based datapackage and dataresource schema (odam-data-package.json, odam-data-resource.json) that maps ODAM concepts (ODAM Table Schema, ODAM Categories, ODAM CV Term) into a datapackage. The seed provides these schema files and explains generation of datapackage.json from the ODAM API."
    }
  ],
