{
  "record_id": "1131",
  "record_dir": "1131_NWB",
  "standards": [
    {
      "standard_id": "NWB",
      "name": "Neurodata Without Borders (NWB)",
      "abstract": "Neurodata Without Borders (NWB) is a community-developed data standard and software ecosystem for cellular-scale neurophysiology and related behavioral data. It is designed to store heterogeneous neurophysiology modalities (intracellular and extracellular electrophysiology, optical physiology, tracking and stimulus data) recorded across diverse experimental conditions and species, and to package raw and processed data together with rich metadata. The NWB project maintains a formal format specification (schema expressed in YAML/JSON), reference APIs (PyNWB, MatNWB, AqNWB), conversion tools (NeuroConv, NWB GUIDE), and supporting tooling and archives (e.g., DANDI).",
      "classification": {
        "assigned_types": [
          "table"
        ],
        "fairsharing_record_type_hint": null,
        "rationale": "The source material is a formal format specification and schema (YAML/JSON) that defines explicit named fields, datasets, attributes, groups, and their concrete data types/formats (e.g., isodatetime, text, numeric arrays, enums). The nwb.schema and associated JSON schemas present true field-level structure (e.g., NWBFile attributes, Subject properties) rather than only prose guidance, so the standard is best represented as a table of metadata fields."
      },
      "principles": null,
      "dag": null,
      "table": {
        "fields": {
          "NWBFile.identifier": {
            "name": "identifier",
            "descr": "A unique text identifier for the NWB file.",
            "type": "string",
            "possible_values": null,
            "evidence": "A unique text identifier for the file. For example, concatenated lab name, file creation date/time and experimentalist, or a hash of these and/or other values. The goal is that the string should be unique to all other files.",
            "raw_full_info": {}
          },
          "NWBFile.session_start_time": {
            "name": "session_start_time",
            "descr": "Date and time of the experiment/session start (ISO 8601 with timezone).",
            "type": "date-time",
            "possible_values": null,
            "evidence": "'Date and time of the experiment/session start. The date is stored in UTC with local timezone offset as ISO 8601 extended formatted string: 2018-09-28T14:43:54.123+02:00. Dates stored in UTC end in \"Z\" with no timezone offset. Date accuracy is up to milliseconds.'",
            "raw_full_info": {}
          },
          "NWBFile.session_description": {
            "name": "session_description",
            "descr": "A description of the experimental session and data in the file.",
            "type": "string",
            "possible_values": null,
            "evidence": "A description of the experimental session and data in the file.",
            "raw_full_info": {}
          },
          "NWBFile.timestamps_reference_time": {
            "name": "timestamps_reference_time",
            "descr": "Date/time corresponding to time zero for timestamps in the file (ISO 8601).",
            "type": "date-time",
            "possible_values": null,
            "evidence": "'Date and time corresponding to time zero of all timestamps. The date is stored in UTC with local timezone offset as ISO 8601 extended formatted string: 2018-09-28T14:43:54.123+02:00. Dates stored in UTC end in \"Z\" with no timezone offset. Date accuracy is up to milliseconds. All times stored in the file use this time as reference (i.e., time zero).'",
            "raw_full_info": {}
          },
          "NWBFile.file_create_date": {
            "name": "file_create_date",
            "descr": "Record of the date the file was created and of subsequent modifications (array of ISO 8601 datetimes).",
            "type": "array<date-time>",
            "possible_values": null,
            "evidence": "'A record of the date the file was created and of subsequent modifications. The date is stored in UTC with local timezone offset as ISO 8601 extended formatted strings: 2018-09-28T14:43:54.123+02:00. Dates stored in UTC end in \"Z\" with no timezone offset. Date accuracy is up to milliseconds. The file can be created after the experiment was run, so this may differ from the experiment start time. Each modification to the nwb file adds a new entry to the array.'",
            "raw_full_info": {}
          },
          "Subject.subject_id": {
            "name": "subject_id",
            "descr": "ID of animal/person used/participating in experiment (lab convention).",
            "type": "string",
            "possible_values": null,
            "evidence": "\"subject_id\": { \"type\": \"string\", \"description\": \"ID of animal/person used/participating in experiment (lab convention)\" }",
            "raw_full_info": {}
          },
          "Subject.species": {
            "name": "species",
            "descr": "Species of subject. Use Latin binomial name or NCBI Taxonomy reference.",
            "type": "ontology_term",
            "possible_values": null,
            "evidence": "\"species\": { \"type\": \"string\", \"description\": \"Species of subject. Use latin name.\", \"pattern\": \"^[A-Z][a-z]+ [a-z]+|http://purl.obolibrary.org/obo/NCBITaxon_[0-9]+\" }",
            "raw_full_info": {}
          },
          "Subject.sex": {
            "name": "sex",
            "descr": "Sex of subject encoded as a controlled vocabulary value.",
            "type": "enum/controlled_vocabulary",
            "possible_values": [
              "M",
              "F",
              "U",
              "O",
              "XX",
              "XO"
            ],
            "evidence": "\"sex\": { \"type\": \"string\", \"enum\": [ \"M\", \"F\", \"U\", \"O\", \"XX\", \"XO\" ] }",
            "raw_full_info": {}
          },
          "Subject.age": {
            "name": "age",
            "descr": "The age of the subject. ISO 8601 Duration format is recommended (e.g., 'P90D').",
            "type": "string",
            "possible_values": null,
            "evidence": "\"The age of the subject. The ISO 8601 Duration format is recommended, e.g., 'P90D' for 90 days old, 'P2W' for 2 weeks old, 'P18Y' for 18 years old.'",
            "raw_full_info": {}
          },
          "TimeSeries.data": {
            "name": "data",
            "descr": "Data values for a TimeSeries. Data can be 1-D..4-D and the first dimension should always represent time.",
            "type": "numeric array (float)",
            "possible_values": null,
            "evidence": "Data values. Data can be in 1-D, 2-D, 3-D, or 4-D. The first dimension should always represent time. This can also be used to store binary data (e.g., image frames). This can also be a link to data stored in an external file.",
            "raw_full_info": {}
          }
        }
      },
