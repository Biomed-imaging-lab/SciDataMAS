    {
      "standard_id": "FAANG:sample_metadata",
      "name": "FAANG sample metadata specification",
      "description": "Specification for sample-level metadata to submit to BioSamples: required and optional attributes for organisms, specimens, animals, pools and cell types; ontology usage (EFO/UBERON/LBO/etc.), naming, units and submission guidance."
    },
    {
      "standard_id": "FAANG:experiment_metadata",
      "name": "FAANG experiment metadata specification",
      "description": "Experiment-level metadata standard describing common required fields (sample reference, assay type, storage/processing, extraction protocol), assay-specific requirements (e.g. ATAC-seq, ChIP-seq, RNA-seq, Hi-C, bisulfite), ontology-term use and archive submission guidance."
    },
    {
      "standard_id": "FAANG:analysis_metadata",
      "name": "FAANG analysis metadata specification",
      "description": "Specification for analysis/result metadata: required process attributes (input files, reference data, reproducible analysis protocol including software versions and command-lines), QC metrics, file naming conventions and guidance for archiving analyses."
    },
    {
      "standard_id": "FAANG:data_type_definitions",
      "name": "FAANG data type definitions",
      "description": "Definitions of allowed data types for FAANG attributes (date, NCBI taxon ID, number with units, protocol URL, text, URL, ontology term, location, sample references) and conventions for units and term sources."
    },
    {
      "standard_id": "FAANG:validation_json_schema",
      "name": "FAANG JSON Schema validation rulesets",
      "description": "Machine-readable JSON Schema rules and validation rulesets (core and module-level) for samples, experiments and analyses (including legacy variants and assay-specific modules like ChIP-seq), used with FAANG validation tooling to enforce the above standards."
    }
  ],
