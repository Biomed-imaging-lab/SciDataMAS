  "standards": [
    {
      "standard_id": "ECO",
      "name": "Evidence & Conclusion Ontology (ECO)",
      "abstract": "ECO is an ontology of evidence types and assertion methods used in biological research. It covers evidence that arises from laboratory experiments, computational methods, literature curation, and other means, encoded as ontology classes and relations rather than as simple text fields. The project (maintained by the Evidence & Conclusion Ontology team; code and releases on GitHub and purl.obolibrary.org) addresses the problem of consistently capturing the type of evidence that supports biological assertions (for example gene annotations), enabling provenance tracking, quality control, and evidence-aware queries. ECO also supplies resources such as mappings to Gene Ontology evidence codes and a documented process for requesting new terms.",
      "classification": {
        "assigned_types": [
          "dag"
        ],
        "fairsharing_record_type_hint": null,
        "rationale": "The primary structure published by ECO is an ontology: a network of classes and subclass/relational links (a directed hierarchical graph). The source material presents explicit class hierarchies, subclass relations, and formal OWL/OWL-XML files (i.e. nodes and directed edges), so the best fit for its actual structure is a DAG (ontology graph)."
      },
      "principles": null,
      "dag": {
        "nodes": {
          "eco_root": {
            "node_id": "eco_root",
            "name": "Evidence & Conclusion Ontology (ECO)",
            "description": "The project/ontology itself: a structured vocabulary of evidence types used in biocuration and annotations.",
            "evidence": "\"The Evidence & Conclusion Ontology (ECO) describes types of scientific evidence within the biological research domain that arise from laboratory experiments, computational methods, literature curation, or other means.\" (README / eco-base.owl)"
          },
          "evidence_class": {
            "node_id": "evidence_class",
            "name": "evidence (upper-level class)",
            "description": "Upper-level ontology class representing types of information used to support assertions.",
            "evidence": "\"'evidence' is defined as \\\"a type of information that is used to support an assertion\\\"\" (README / site1)"
          },
          "assertion_method_class": {
            "node_id": "assertion_method_class",
            "name": "assertion method (upper-level class)",
            "description": "Upper-level ontology class representing the means by which a statement/assertion is made (e.g. by a human curator or automatically).",
            "evidence": "\"'assertion method' is defined as \\\"a means by which a statement is made about an entity.\\\"\" (README / site1)"
          },
          "combined_usage": {
            "node_id": "combined_usage",
            "name": "Combined description: evidence + assertion method",
            "description": "ECO's intended usage: combine an evidence term with an assertion-method term to record both what supports an assertion and who/what made it (human vs computer).",
            "evidence": "\"Together evidence and assertion method can be combined to describe both the support for an assertion and whether that assertion was made by a human being or a computer.\" (site1 / README)"
          },
          "go_mapping_file": {
            "node_id": "go_mapping_file",
            "name": "GO ↔ ECO mapping (gaf-eco-mapping.txt)",
            "description": "A resource file that maps GO root evidence codes (and more granular ECO terms) to ECO identifiers to enable interoperability with Gene Ontology annotation formats.",
            "evidence": "\"This mapping translates GO root evidence codes used in a GAF to a specific evidence type in ECO\" (gaf-eco-mapping.txt header)"
          },
          "submit_term_checklist": {
            "node_id": "submit_term_checklist",
            "name": "Submit New Term checklist",
            "description": "Checklist of information elements required when requesting a new ECO term (term label, parent term, Aristotelian definition, definition reference, requester contact, additional optional fields).",
            "evidence": "\"The following is a checklist of information elements that are required to create a complete term in ECO.\" (Submit Term Request page)"
          }
