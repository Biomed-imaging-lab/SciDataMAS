    {
      "standard_id": "IHIW-XML",
      "name": "IHIW XML (Workshop XML NGS HLA Typing Report)",
      "description": "An XML schema (IHIW XML v1.4) for reporting NGS HLA typing reports and associated metadata for IHIW projects. Defines elements/attributes for Lab, Software_Applied, Hardware_Used, Reagent_Protocol, Sample, Genotyping (including Genotype_GL), Locus (alignment/base-calling references, consensus sequence, features, mean read depth, phasing), NovelPolymorphism notation, and other metadata needed to contextualize HLA genotyping results."
    },
    {
      "standard_id": "HML-1.0.1",
      "name": "HML (Histoimmunogenetics Markup Language) 1.0.1",
      "description": "An XML-based document format/schema for encoding HLA genotyping results (protocols, sequences, and interpretations). The record recommends HML 1.0.1 as the vendor submission format and references its XSD (strict schema) for validation of genotyping documents."
    },
    {
      "standard_id": "MIRING",
      "name": "MIRING (Minimum Information for Reporting Immunogenomic NGS Genotyping)",
      "description": "A community guideline/specification listing the minimum metadata elements and best-practice annotations required when reporting NGS HLA genotyping results (e.g., experimental context, references, quality metrics). The repository cites MIRING as part of validation guidance for HML/IHIW reports."
    },
    {
      "standard_id": "GL-String",
      "name": "GL Strings (Genotype List Strings)",
      "description": "A compact string-standard for representing HLA genotypes, including ambiguity and phasing information. The IHIW materials require genotypes be reported as valid GLStrings and reference the defining publication/format for genotype encoding."
    }
  ],
