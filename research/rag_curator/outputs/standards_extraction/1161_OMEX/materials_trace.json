  "roster": [
    {
      "standard_id": "COMBINE/OMEX",
      "name": "COMBINE Archive (OMEX)",
      "description": "An archive format/specification for bundling computational modeling projects (models, simulation descriptions, metadata, docs) into a single .omex/combine archive. Used to package SBML/BNGL models together with SED-ML experiment files and other supporting files."
    },
    {
      "standard_id": "SED-ML",
      "name": "SED-ML (Simulation Experiment Description Markup Language)",
      "description": "A machine-readable format for encoding simulation experiments: which models to run, which simulation algorithms and settings to use, and which outputs to produce. Used to describe reproducible simulation experiments and is commonly included inside COMBINE/OMEX archives."
    },
    {
      "standard_id": "SBML",
      "name": "SBML (Systems Biology Markup Language)",
      "description": "An XML-based standard format for representing computational models of biochemical networks (e.g., ordinary differential equation-based kinetic models). Commonly used as an exchange format for models that runBioSimulations supports."
    },
    {
      "standard_id": "BNGL",
      "name": "BNGL (BioNetGen Language)",
      "description": "A rule-based modeling language/format for specifying biochemical reaction networks using rules rather than enumerating all species; used as a model format supported by runBioSimulations."
    }
  ],
