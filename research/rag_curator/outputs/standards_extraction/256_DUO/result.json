  "standards": [
    {
      "standard_id": "DUO",
      "name": "Data Use Ontology (DUO)",
      "abstract": "DUO (Data Use Ontology) is an ontology for tagging datasets — particularly human genomics and health/clinical research datasets — with machine-readable data-use permissions and modifiers derived from informed-consent restrictions. It encodes terms such as disease-specific restrictions, general research use, non-commercial use, and other modifiers (e.g. IRB approval required), represented as OWL classes and distributed by the GA4GH/EBI community. DUO is maintained as an OBO/OWL ontology (available via http://purl.obolibrary.org/obo/duo.owl), published under CC-BY 4.0, and aimed at enabling automated discovery and access decisions across repositories by standardizing the vocabulary for data-use limitations.",
      "classification": {
        "assigned_types": [
          "table"
        ],
        "fairsharing_record_type_hint": null,
        "rationale": "The source distribution includes a concrete CSV (duo.csv) that lists ontology terms in a tabular format with named columns (id, shorthand, label, description). Although DUO is implemented as an OWL ontology, the repository provides a genuine field-level table (duo.csv) that defines the tabular extractable structure of the standard."
      },
