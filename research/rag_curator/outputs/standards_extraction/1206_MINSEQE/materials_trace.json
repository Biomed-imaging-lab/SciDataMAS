    {
      "standard_id": "MINSEQE",
      "name": "MINSEQE",
      "description": "Minimum Information about a high-throughput Nucleotide SEQuencing Experiment — a reporting guideline/checklist for next-generation sequencing (HTS/NGS) experiments (RNA‑Seq, ChIP‑Seq, DNA‑methylation, etc.). Specifies required metadata: biological system and sample annotation (experimental factors), raw sequence read data and base-level quality scores (FASTQ recommended), final processed/summary data formats, sample‑to‑data relationships, and essential experimental and data‑processing protocols (library prep, instrumentation, alignment and filtering methods)."
    },
    {
      "standard_id": "MIAME",
      "name": "MIAME",
      "description": "Minimum Information About a Microarray Experiment — a reporting guideline for microarray-based transcriptomics. Defines the minimum content needed to interpret and reproduce microarray studies: raw assay data (e.g., CEL), final processed/normalized data matrices, essential sample annotation and experimental factors, experimental design and sample‑data relationships, feature/array annotation, and laboratory and data‑processing protocols."
    }
  ],
