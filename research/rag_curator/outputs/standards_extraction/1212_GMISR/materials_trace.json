    {
      "standard_id": "stroke-minimum-information-v1",
      "name": "Minimum Information Required Guideline for Stroke Research and Clinical Data Reporting (Version 1.0)",
      "description": "A domain-specific minimum-information reporting guideline for stroke research and clinical data. Defines participant-, study-, and experiment-level data elements (classified as essential or optional), provides definitions using existing ontologies, and includes an associated REDCap XML schema for implementation to support standardized data capture, sharing, and interoperability."
    },
    {
      "standard_id": "phenx-toolkit-measures",
      "name": "PhenX Toolkit (consensus measures for Phenotypes and eXposures)",
      "description": "A curated catalogue of standardized phenotype and exposure measures for biomedical research aimed at promoting harmonised data collection across studies; the seed material references its stroke-related measures (e.g. stroke history) and describes PhenX as a resource used to recommend data collection measures."
    }
  ],
