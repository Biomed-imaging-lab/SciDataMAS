  "roster": [
    {
      "standard_id": "chado-xml",
      "name": "Chado-XML",
      "description": "An XML representation/mapping of the GMOD Chado relational schema. Defines element names and structure (DTD/XSD/RNG/RNC referenced), two mapping styles (Standard Mapping that mirrors nested features, and Generic Mapping), support for macros (normalized vs denormalized XML), recommended file suffixes (.chado-xml, .chado.xml, .chado), and guidance for generating/saving via tools such as XORT and BioPerl. Covers the same modular scope as Chado (sequence, CVs, organisms, features, etc.)."
    },
    {
      "standard_id": "chado-schema",
      "name": "Chado (relational schema)",
      "description": "The modular Chado relational database schema for biological data used by GMOD. Covers multiple modules (sequence, CV/ontology tables, features, organisms, relationships, etc.), table/column semantics, loading best practices (GFF3 loaders, bulk loaders), and troubleshooting/FAQ material about installing/loading ontologies and populating the schema. The Chado-XML spec maps directly to this schema (XML elements correspond to DB tables/columns)."
    }
  ],
