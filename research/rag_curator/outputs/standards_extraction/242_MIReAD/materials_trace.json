    {
      "standard_id": "MIReAD",
      "name": "MIReAD (Minimum Information for Reusable Arthropod Abundance Data)",
      "description": "A domain-specific minimum information metadata standard for reporting arthropod abundance/time-series data. Defines the core metadata needed to make arthropod surveillance and abundance datasets reusable and interoperable (e.g., contextual information about sampling events, spatial/temporal coverage, sampling methods/trap types and counting units, taxonomic identification and life stage, and data provenance), designed to support FAIR public data archiving and facilitate data unification across pest and vector surveillance initiatives."
    }
