  "roster": [
    {
      "standard_id": "MIRAGE-SP-1.0",
      "name": "MIRAGE Sample Preparation Guidelines (v1.0)",
      "description": "Reporting standard for glycomics sample generation, purification and modification: specifies required metadata about sample origin (biological or chemical), isolation, enzymatic/chemical treatments, modifications, purification steps and defined sample naming to enable reproducible glycomics experiments."
    },
    {
      "standard_id": "MIRAGE-MS-Glycans-1.0",
      "name": "MIRAGE Mass Spectrometric Analysis Guidelines (glycans & glycoproteins)",
      "description": "Mass-spectrometry reporting guidelines for glycomics specifying metadata to record instrument methods, sample handling, acquisition and processing for glycan and glycoprotein MS datasets to support reproducibility and data interpretation."
    },
    {
      "standard_id": "MIRAGE-GlycanMicroarray-1.0",
      "name": "MIRAGE Glycan Microarray Analysis Guidelines (v1.0)",
      "description": "Guidelines for reporting glycan microarray experiments: what experimental and array metadata to capture (array composition, spotting, binding assays, controls, data processing) to allow interpretation and reuse of glycan-binding microarray results."
    },
    {
      "standard_id": "MIRAGE-LC-1.0",
      "name": "MIRAGE Liquid Chromatography Analysis Guidelines (v1.0)",
      "description": "Reporting standard for liquid chromatography workflows in glycomics: defines required LC method metadata (columns, gradients, solvents, flow rates), sample handling and linking to downstream MS or detection to ensure reproducible chromatographic data."
    },
    {
      "standard_id": "MIRAGE-NMR-Recognition-1.0",
      "name": "MIRAGE NMR Glycan Recognition Guidelines (v1.0)",
      "description": "Guideline module focused on reporting NMR experiments used to assess glycan–ligand recognition: metadata on sample conditions, NMR acquisition parameters, processing and interpretation needed for reproducible NMR-based recognition studies."
    },
    {
      "standard_id": "MIRAGE-NMR-Structures-1.0",
      "name": "MIRAGE NMR Glycan Structures Guidelines (v1.0)",
      "description": "NMR reporting recommendations for determining and describing glycan three-dimensional structures: required metadata about NMR experiments, restraints, structure calculation and validation to support structural glycomics."
    },
    {
      "standard_id": "MIRAGE-CE-1.0",
      "name": "MIRAGE Capillary Electrophoresis Analysis Guidelines (v1.0)",
      "description": "Reporting standard for capillary electrophoresis in glycomics: specifies metadata about CE instrument parameters, sample preparation, buffers and data analysis for reproducible electrophoretic glycan profiling."
    },
    {
      "standard_id": "MIRAGE-LectinArray-1.0",
      "name": "MIRAGE Lectin Microarray Analysis Guidelines (v1.0)",
      "description": "Guidelines for reporting lectin microarray experiments: metadata requirements for array composition, lectin characteristics, assay conditions, controls and data processing to allow interpretation and reuse of lectin-binding datasets."
    },
    {
      "standard_id": "MIRAGE-MS-Guidelines-Glycosciences",
      "name": "MIRAGE MS Guidelines for Glycosciences (MS reporting guidelines)",
      "description": "A broader set of MS reporting recommendations for glycoscience communities summarizing principles and exemplar reporting practices for MS-derived glycomics data; linked to exemplar publications and planned exemplar datasets."
    },
    {
      "standard_id": "STRENDA",
      "name": "STRENDA Reporting Guidelines (STRENDA)",
      "description": "Standards for reporting enzymology data (STRENDA): metadata requirements and best practices for enzyme kinetics and activity reporting, including connections to the STRENDA DB for validated, FAIR enzymology datasets."
    },
    {
      "standard_id": "EnzymeML",
      "name": "EnzymeML",
      "description": "Structured data-exchange format / metadata standard for enzymology experiments: specifies a machine-readable schema for encoding experimental protocols, kinetic data and metadata to enable reproducible exchange and processing of enzyme-related datasets."
    }
  ],
