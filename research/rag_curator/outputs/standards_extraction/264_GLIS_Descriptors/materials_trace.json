    {
      "standard_id": "GLIS_DOI_descriptors_v2.1",
      "name": "Data required for the assignation of Digital Object Identifiers in the Global Information System (GLIS descriptors) v2.1",
      "description": "A descriptor set specifying mandatory, highly recommended and additional metadata fields required when registering Plant Genetic Resources for Food and Agriculture (PGRFA) with Digital Object Identifiers (DOIs) in the GLIS portal. Covers field-level requirements (e.g. M01 Organisation, M02 PGRFA unique identifier, M03 Date, M04 Method), classes of descriptors, examples/use cases, and guidance on interoperability with existing identifiers; intended to standardize metadata for DOI assignment and cross-system integration."
    },
    {
      "standard_id": "MCPD_v2.1",
      "name": "FAO/Bioversity Multi-Crop Passport Descriptors (MCPD) v2.1",
      "description": "A passport-data metadata standard for plant genetic resources that defines standardized fields such as institute codes, accession numbers and acquisition dates to describe germplasm holdings. The GLIS DOI descriptors explicitly map several descriptors to MCPD equivalents and reference MCPD as an existing standard for passport information."
    }
  ],
