      "standard_id": "https://bitbucket.org/PlantExpAssay/ontology/raw/master/PlantExperimentalAssayOntology.owl",
      "name": "Plant Experimental Assay Ontology (PEAO)",
      "description": "An OWL ontology for the plant domain that models experimental assays: entities across biological, physical and data realms, protocol steps, samples and operations, and data properties (e.g. gel electrophoresis parameters, image_data attributes). Intended for annotating plant experimental procedures, data integration and querying heterogeneous experimental data."
    },
    {
      "standard_id": "https://bitbucket.org/PlantExpAssay/ontology/raw/master/ExperimentalPipelines.owl",
      "name": "Experimental Pipelines Ontology (XPO)",
      "description": "A high-level OWL ontology for modeling experimental pipelines and procedures (domain-independent). Centers on 'sample' and 'operation' concepts (operations applied to samples producing new samples), with object and annotation properties to describe procedures, apparatus, equipment, and relationships needed to represent experimental workflows."
    }
  ],
