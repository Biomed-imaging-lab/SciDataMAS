  "roster": [
    {
      "standard_id": "ome-data-model",
      "name": "OME Data Model",
      "description": "A specification for representing biological imaging metadata (image parameters such as XYZ dimensions and pixel types, acquisition metadata including microscope, detectors, settings, annotations, ROIs, units, and ID conventions). It is a conceptual/schema-level metadata model used to standardize exchange between imaging software."
    },
    {
      "standard_id": "ome-xml",
      "name": "OME-XML",
      "description": "An XML-based file format implementing the OME Data Model to store microscopy information (both pixels and metadata). Describes 5-D pixel sets, acquisition and experimental metadata, structured annotations, schema (.xsd) files, and options for base64 pixel encoding and compression; intended for migration and interchange of image+metadata."
    },
    {
      "standard_id": "ome-tiff",
      "name": "OME-TIFF",
      "description": "A TIFF container format that embeds OME-XML metadata in the TIFF header to combine TIFF-compatible pixel storage with standardized OME metadata. Described as a multi-plane TIFF enabling general TIFF readers to access pixels while OME-aware applications extract the embedded metadata."
    }
  ],
