  "roster": [
    {
      "standard_id": "faang.sample",
      "name": "FAANG Sample Metadata Specification",
      "description": "Defines required, recommended and optional attributes for biological samples (animals, specimens, cell types, pools) to be submitted to BioSamples; includes controlled vocabularies/ontology use (UBERON, PATO, Livestock Breed Ontology), units, links and parent/child sample relationships and submission guidance."
    },
    {
      "standard_id": "faang.experiment",
      "name": "FAANG Experiment Metadata Specification",
      "description": "Specifies metadata for experiments (sequencing and array assays), enumerates allowed assay types and assay-specific required fields (e.g. ChIP‑seq, ATAC‑seq, RNA‑seq, Hi‑C), provenance fields (sample reference, extraction/expt protocols, storage, dates) and archive submission guidance (ENA/SRA/ArrayExpress/GEO)."
    },
    {
      "standard_id": "faang.analysis",
      "name": "FAANG Analysis Metadata Specification",
      "description": "Describes how to record analysis results and provenance: input files and experiment links, reference data, exact analysis protocol (software versions, command lines, containers), QC metrics (e.g. total/mapped reads) and file‑naming conventions for reproducible analyses."
    },
    {
      "standard_id": "faang.datatypes",
      "name": "FAANG Data Type Definitions",
      "description": "Defines canonical data types used across FAANG metadata (date, NCBI taxon ID, number with units, protocol URL, text, URL, ontology term, location, sample), including formatting rules (ISO‑8601 dates), unit expectations and guidance on ontologies/term source IDs."
    },
    {
      "standard_id": "faang.validation",
      "name": "FAANG JSON‑Schema Validation Rulesets",
      "description": "Machine‑readable validation rules (JSON Schema) and rule modules used to validate FAANG metadata submissions; encodes required fields, controlled vocabularies and assay‑specific constraints used by the FAANG metadata validator."
    }
  ],
