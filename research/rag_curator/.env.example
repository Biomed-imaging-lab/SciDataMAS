# Copy to `research/rag_curator/.env` before running the experiments.
# Both field_recovery_eval and metadata_completeness_eval load this file.

OPENAI_API_KEY=

# FAIRsharing credentials are only needed if you re-crawl the standards.
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=

# Optional: LangSmith tracing (the experiment scripts force it off).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scidatamas-experiments
