          }
        },
        "compounds.molecular_formula": {
          "name": "compounds.molecular_formula",
          "descr": "Molecular formula of the compound.",
          "type": "string",
          "possible_values": null,
          "evidence": "\"molecular_formula\": \"C19H22O6\"",
          "raw_full_info": {
            "raw": "\"molecular_formula\": \"C19H22O6\" (example from BGC0000001.json)"
          }
        },
        "compounds.mol_mass": {
          "name": "compounds.mol_mass",
          "descr": "Molecular mass (monoisotopic or measured) for the compound.",
          "type": "number",
          "possible_values": null,
          "evidence": "\"mol_mass\": 346.141638424",
          "raw_full_info": {
            "raw": "\"mol_mass\": 346.141638424 (example from BGC0000001.json)"
          }
        },
        "genes.annotations": {
          "name": "genes.annotations",
          "descr": "Per-gene annotations including product, name/id and functional category with evidence.",
          "type": "array of objects",
          "possible_values": null,
          "evidence": "\"functions\": [ { \"function\": { \"name\": \"Precursor\" }, \"evidence\": [ { \"method\": \"Knock-out\", \"references\": [\"pubmed:21183019\"] }, { \"method\": \"Activity assay\", \"references\": [\"pubmed:21183019\"] } ] } ] (example from BGC0000535.json)",
          "raw_full_info": {
            "raw": "\"functions\": [ { \"function\": { \"name\": \"Precursor\" }, \"evidence\": [ { \"method\": \"Knock-out\", \"references\": [\"pubmed:21183019\"] }, { \"method\": \"Activity assay\", \"references\": [\"pubmed:21183019\"] } ] } ]"
          }
        },
        "operons": {
          "name": "operons",
          "descr": "Operon-level grouping of genes with evidence (if applicable).",
          "type": "array of objects",
          "possible_values": null,
          "evidence": "\"operons\": [ { \"genes\": [\"nisA\"], \"evidence\": [ { \"method\": \"rt-PCR\", \"references\": [ ... ] } ] } ] (example from BGC0000311.json)",
          "raw_full_info": {
            "raw": "\"operons\": [ { \"genes\": [\"nisA\"], \"evidence\": [ { \"method\": \"rt-PCR\", \"references\": [...] } ] } ]"
          }
        },
        "evidence_types_examples": {
          "name": "evidence (ontology examples)",
          "descr": "Evidence terms used across the schema for substrate/domain/locus/gene annotations.",
          "type": "enum list (ontology)",
          "possible_values": [
            "Knock-out studies",
            "Enzymatic assays",
            "Heterologous expression",
            "Gene expression correlated with compound production",
            "Sequence-based prediction",
            "Activity assay",
            "ATP-PPi exchange assay",
            "Mass spectrometry",
            "NMR",
            "Structure-based inference",
            "Homology",
            "Feeding study",
            "Other"
          ],
          "evidence": "List of allowed evidence methods (examples) appears in ontologies/substrate_evidence.md and locus_evidence.md, e.g. 'Sequence-based prediction', 'Activity assay', 'Knock-out studies', 'Heterologous expression', 'Enzymatic assays', 'Gene expression correlated with compound production'.",
          "raw_full_info": {
            "raw": "\"- Activity assay\\n- ACVS assay\\n- ATP-PPi exchange assay\\n- Enzyme-coupled assay\\n- Feeding study\\n- Heterologous expression\\n- Homology\\n- HPLC\\n- In-vitro experiments\\n- Knock-out studies\\n- Mass spectrometry\\n- NMR\\n- Radio labelling\\n- Sequence-based prediction\\n- Steady-state kinetics\\n- Structure-based inference\\n- X-ray crystallography\" (excerpt from schema-main/ontologies/substrate_evidence.md)"
          }
        },
        "data_distribution_formats": {
          "name": "data_distribution_formats",
          "descr": "Formats in which MIBiG data and sequences are distributed for download.",
          "type": "enum list / text",
          "possible_values": [
