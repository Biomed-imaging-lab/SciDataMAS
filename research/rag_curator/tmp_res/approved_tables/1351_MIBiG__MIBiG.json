{
  "source_record_dir": "1351_MIBiG",
  "standard_id": "MIBiG",
  "tentative": false,
  "standard": {
    "standard_id": "MIBiG",
    "name": "Minimum Information about a Biosynthetic Gene cluster (MIBiG)",
    "abstract": "MIBiG is a community metadata standard for experimentally characterized biosynthetic gene clusters (BGCs) from bacteria, fungi and plants. It records genomic locus information, gene-level annotations, biosynthetic class and chemistry of produced compounds, and experimental evidence. The standard is implemented as a JSON schema and distributed entries (JSON, GenBank/GBK and FASTA) describing clusters, genes, compounds and biosynthetic module/domain annotations.",
    "classification": {
      "assigned_types": [
        "table"
      ],
      "fairsharing_record_type_hint": null,
      "rationale": "MIBiG is defined primarily as a machine-readable JSON schema / metadata checklist (a structured table of fields) used to describe BGCs and their associated data. The available materials provide comprehensive schema files and form definitions (JSON) describing fields, types and enumerations."
    },
    "principles": null,
    "dag": null,
    "table": {
      "fields": {
        "mibig_accession": {
          "name": "mibig_accession",
          "descr": "MIBiG accession number (unique identifier for the BGC entry).",
          "type": "string",
          "possible_values": null,
          "evidence": "This number should start with 'BGC', followed by numbers: e.g., 'BGC0000829'. If you have not received an MIBiG accession number for your gene cluster yet, please request one first before filling out this form.",
          "raw_full_info": {
            "raw": "\"mibig_accession\": { \"type\": \"string\", \"required\": true, \"title\": \"MIBiG accession number\", \"description\": \"This number should start with 'BGC', followed by numbers: e.g., 'BGC0000829'. If you have not received an MIBiG accession number for your gene cluster yet, please request one first before filling out this form.\" }"
          }
        },
        "biosyn_class": {
          "name": "biosyn_class",
          "descr": "Biosynthetic class (e.g., NRPS, Polyketide, RiPP, Terpene, Saccharide, Alkaloid, Other); multiple selection allowed for hybrids.",
          "type": "string / enum (multiple)",
          "possible_values": [
            "NRP",
            "Polyketide",
            "RiPP",
            "Terpene",
            "Saccharide",
            "Alkaloid",
            "Other"
          ],
          "evidence": "Hold ctrl or cmd key to select multiple classes in the case of a hybrid gene cluster. Select all categories that apply: e.g., a polyketide with sugar monomers attached should be both 'Polyketide' and 'Saccharide'.",
          "raw_full_info": {
            "raw": "\"biosyn_class\": { \"type\": \"string\", \"title\": \"Biosynthetic class\", \"required\": true, \"enum\": [ \"NRP\", \"Polyketide\", \"RiPP\", \"Terpene\", \"Saccharide\", \"Alkaloid\", \"Other\" ], \"description\": \"Hold ctrl or cmd key to select multiple classes in the case of a hybrid gene cluster. Select all categories that apply: e.g., a polyketide with sugar monomers attached should be both 'Polyketide' and 'Saccharide'.\" }"
          }
        },
        "publications": {
          "name": "publications",
          "descr": "Key publications associated with the gene cluster/pathway/molecule (PMIDs or DOIs).",
          "type": "string (PMIDs / DOIs)",
          "possible_values": null,
          "evidence": "Publications describing experiments on this pathway. Please input PubMed IDs (PMIDs, not PMCIDs!), separated by commas: e.g., '12000953,8843436'. Only enter numeric characters and commas. If a PMID is not available, a DOI can be entered instead (without the designation 'DOI' itself, e.g. '10.1039/c4sc01927j')",
          "raw_full_info": {
            "raw": "\"publications\": { \"type\": \"string\", \"pattern\": \"[0-9]{1,}\", \"title\": \"Key publications associated with this gene cluster, pathway or molecule\", \"description\": \"Publications describing experiments on this pathway. Please input PubMed IDs (PMIDs, not PMCIDs!), separated by commas: e.g., '12000953,8843436'. Only enter numeric characters and commas. If a PMID is not available, a DOI can be entered instead (without the designation 'DOI' itself, e.g. '10.1039/c4sc01927j')\" }"
          }
        },
        "loci.complete": {
          "name": "loci.complete",
          "descr": "Whether the gene cluster sequence is complete, incomplete or unknown.",
          "type": "enum",
          "possible_values": [
            "complete",
            "incomplete",
            "unknown"
          ],
          "evidence": "Complete gene cluster sequence?",
          "raw_full_info": {
            "raw": "\"complete\": { \"title\": \"Complete gene cluster sequence?\", \"type\": \"string\", \"enum\": [ \"complete\", \"incomplete\", \"unknown\" ], \"required\": true }"
          }
        },
        "loci.nucl_acc": {
          "name": "loci.nucl_acc",
          "descr": "GenBank nucleotide accession number and coordinates for the locus.",
          "type": "object (accession, start_coord, end_coord)",
          "possible_values": null,
          "evidence": "GenBank nucleotide accession number. E.g., AL645882. Only use GenBank accessions, not RefSeq accessions or GI numbers.",
          "raw_full_info": {
            "raw": "\"Accession\": { \"title\": \"GenBank nucleotide accession number\", \"type\": \"string\", \"description\": \"E.g., AL645882. Only use GenBank accessions, not RefSeq accessions or GI numbers.\", \"required\": true }"
          }
        },
        "loci.conn_comp_cluster": {
          "name": "loci.conn_comp_cluster",
          "descr": "Evidence that links the locus to the production of the designated molecules (evidence of involvement).",
          "type": "enum (multiple)",
          "possible_values": [
            "Knock-out studies",
            "Enzymatic assays",
            "Heterologous expression",
            "Gene expression correlated with compound production",
            "Sequence-based prediction",
            "Other"
          ],
          "evidence": "Type of evidence that shows that this gene cluster is responsible for the biosynthesis of the designated molecules. Hold ctrl or cmd key for multiple selection.",
          "raw_full_info": {
            "raw": "\"conn_comp_cluster\": { \"title\": \"Evidence of involvement\", \"description\": \"Type of evidence that shows that this gene cluster is responsible for the biosynthesis of the designated molecules. Hold ctrl or cmd key for multiple selection.\", \"type\": \"string\", \"required\": true, \"enum\": [ \"Knock-out studies\", \"Enzymatic assays\", \"Heterologous expression\", \"Gene expression correlated with compound production\", \"Sequence-based prediction\", \"Other\" ] }"
          }
        },
        "compounds._entry": {
          "name": "compounds (entry-level)",
          "descr": "Per-compound information: one entry per molecule produced by the pathway / gene cluster.",
          "type": "array of objects",
          "possible_values": null,
          "evidence": "Add one entry for each molecule produced from this pathway / gene cluster.",
          "raw_full_info": {
            "raw": "\"compounds\": { \"type\": \"array\", \"title\": \"__ Chemical compound(s)\", \"required\": true, \"description\": \"Add one entry for each molecule produced from this pathway / gene cluster.\" }"
          }
        },
        "compounds.compound": {
          "name": "compounds.compound",
          "descr": "Compound name (main product name).",
          "type": "string",
          "possible_values": null,
          "evidence": "\"compound\": { \"type\": \"string\", \"title\": \"Compound name\", \"required\": true }",
          "raw_full_info": {
            "raw": "\"compound\": { \"type\": \"string\", \"title\": \"Compound name\", \"required\": true }"
          }
        },
        "compounds.chem_struct": {
          "name": "compounds.chem_struct",
          "descr": "Chemical structure (SMILES or other representation) for the compound.",
          "type": "string",
          "possible_values": null,
          "evidence": "\"chem_struct\": \"CC1C[C@]23OC(=O)C4=C2OC1C(O)C3\\\\C=C/C(=O)[C@@H](C)C[C@@H](C)C4=O\",",
          "raw_full_info": {
