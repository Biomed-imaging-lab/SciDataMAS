  "roster": [
    {
      "standard_id": "SBO",
      "name": "Systems Biology Ontology (SBO)",
      "description": "An ontology of controlled, relational vocabularies for systems biology computational modeling. SBO defines six orthogonal vocabularies covering (1) roles of reaction participants (e.g., substrate), (2) quantitative parameters (e.g., Michaelis constant), (3) classification of mathematical expressions/descriptions (e.g., mass action rate law), (4) modeling frameworks (e.g., logical framework), (5) entity types (e.g., macromolecule), and (6) interaction/process types. Provided in OBO/OWL formats, intended for annotating models and experimental results, browsable via the EBI Ontology Lookup Service and maintained in a GitHub repository."
    }
  ],
